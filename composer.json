{
    "name": "tu-organizacion/central-logger-ci4",
    "description": "Librería de logs centralizados para CodeIgniter 4 que intercepta eventos críticos y los envía a un servicio centralizado vía HTTP",
    "type": "library",
    "license": "MIT",
    "keywords": ["codeigniter4", "logging", "centralized-logging", "error-tracking"],
    "authors": [
        {
            "name": "Tu Organización",
            "email": "dev@tu-organizacion.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "codeigniter4/framework": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "TuOrganizacion\\CentralLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TuOrganizacion\\CentralLogger\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
