{
    "name": "sverguecio/central-logger-ci4",
    "description": "Librería de logs centralizados para CodeIgniter 4 que intercepta eventos críticos y los envía a un servicio centralizado vía HTTP",
    "type": "library",
    "license": "MIT",
    "keywords": ["codeigniter4", "logging", "centralized-logging", "error-tracking"],
    "homepage": "https://github.com/sverguecio/central-logger-ci4",
    "authors": [
        {
            "name": "Sebastian Verguecio",
            "homepage": "https://github.com/sverguecio"
        }
    ],
    "support": {
        "issues": "https://github.com/sverguecio/central-logger-ci4/issues",
        "source": "https://github.com/sverguecio/central-logger-ci4"
    },
    "require": {
        "php": ">=8.0",
        "codeigniter4/framework": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "TuOrganizacion\\CentralLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TuOrganizacion\\CentralLogger\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
