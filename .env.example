# Ejemplo de configuración .env para Central Logger CI4
# Copia estas líneas a tu archivo .env y ajusta los valores

#--------------------------------------------------------------------
# CENTRAL LOGGER CONFIGURATION
#--------------------------------------------------------------------

# URL del endpoint del servicio centralizado de logs
# Ejemplo: https://api-logs.tudominio.com/api/logs
CENTRAL_LOGGER_API_URL=

# Token de autenticación para el servicio de logs
# Genera un token seguro: openssl rand -hex 32
CENTRAL_LOGGER_API_KEY=

# Nombre único de esta aplicación (identificador)
# Ejemplos: app-facturacion, app-inventario, app-crm
# IMPORTANTE: Debe ser único para cada aplicación
CENTRAL_LOGGER_APP_NAME=

# Entorno de ejecución
# Valores permitidos: production, staging, development, testing
# Por defecto usa la variable CI_ENVIRONMENT
CENTRAL_LOGGER_ENVIRONMENT=${CI_ENVIRONMENT}

# Timeout en segundos para la petición HTTP
# Recomendado: 2.0 (no aumentar demasiado para no bloquear la app)
CENTRAL_LOGGER_TIMEOUT=2.0

# Nivel mínimo de log a enviar al servicio central
# Valores (de más a menos restrictivo):
#   - emergency: Solo emergencias del sistema
#   - alert: Alertas + emergencies
#   - critical: Críticos + alert + emergency (RECOMENDADO)
#   - error: Errores + niveles superiores
#   - warning: Warnings + niveles superiores
#   - notice: Notices + niveles superiores
#   - info: Info + niveles superiores
#   - debug: Todos los niveles (solo para desarrollo/testing)
CENTRAL_LOGGER_THRESHOLD=critical
